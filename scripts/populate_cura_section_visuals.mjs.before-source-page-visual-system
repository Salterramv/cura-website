import { createClient } from "@supabase/supabase-js"

const url =
  process.env.NEXT_PUBLIC_SUPABASE_URL

const key =
  process.env.SUPABASE_SERVICE_ROLE_KEY ||
  process.env.SUPABASE_SERVICE_KEY

if (!url) {
  throw new Error("NEXT_PUBLIC_SUPABASE_URL is missing.")
}

if (!key) {
  throw new Error(
    "SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SERVICE_KEY is missing."
  )
}

const supabase = createClient(url, key)

/*
 * ============================================================
 * CURA SOURCE-ONLY VISUAL SYSTEM
 * ============================================================
 *
 * IMPORTANT:
 *
 * This file deliberately DOES NOT generate illustrations from
 * section titles.
 *
 * A visual is allowed only when it is explicitly registered
 * below as a recreation of a visual/diagram/structured visual
 * that exists in the supplied source material.
 *
 * No matching source visual = no illustration.
 * ============================================================
 */

