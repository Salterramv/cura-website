function clean(value) {
  return String(value || "")
    .toLowerCase()
    .replace(/[–—-]/g, " ")
    .replace(/[^a-z0-9\s/]/g, " ")
    .replace(/\s+/g, " ")
    .trim()
}

function matchesSection(title, patterns) {
  return patterns.some((pattern) =>
    pattern.test(String(title || "").trim())
  )
}

function sourceVisualFor(topic, section) {
  const topicSlug = clean(topic.slug)
  const title = String(section.title || "").trim()

  return SOURCE_VISUALS.find((entry) =>
    clean(entry.topic) === topicSlug &&
    matchesSection(title, entry.sectionPatterns)
  ) || null
}

async function loadAllTopics() {
  const { data, error } = await supabase
    .from("education_topics")
    .select("id,slug,title")
    .order("display_order", { ascending: true })

  if (error) throw error
  return data || []
}

async function loadSections(topicId) {
  const { data, error } = await supabase
    .from("education_sections")
    .select("id,title,display_order,presentation")
    .eq("topic_id", topicId)
    .order("display_order", { ascending: true })

  if (error) throw error
  return data || []
}

function removeVisualKeys(presentation) {
  if (!presentation || typeof presentation !== "object") {
    return presentation || {}
  }

  const next = { ...presentation }

  const visualKeys = [
    "visual",
    "visuals",
    "illustration",
    "illustrations",
    "cura_visual",
    "cura_visuals",
    "cura_illustration",
    "cura_illustrations",
    "source_visual",
    "source_illustration",
    "section_visual",
    "section_illustration",
  ]

  for (const key of visualKeys) {
    delete next[key]
  }

  return next
}

async function updateSection(section, visual) {
  const base =
    removeVisualKeys(section.presentation)

  const presentation = visual
    ? {
        ...base,
        cura_source_visual: visual
      }
    : base

  const { error } = await supabase
    .from("education_sections")
    .update({
      presentation,
      updated_at: new Date().toISOString()
    })
    .eq("id", section.id)

  if (error) throw error
}

async function main() {
  console.log("")
  console.log("============================================================")
  console.log(" CURA SOURCE-ONLY ILLUSTRATION RESET")
  console.log("============================================================")
  console.log("")

  const topics = await loadAllTopics()

  let cleared = 0
  let applied = 0

  for (const topic of topics) {
    const sections = await loadSections(topic.id)

    for (const section of sections) {
      const match = sourceVisualFor(topic, section)

      await updateSection(
        section,
        match ? match.visual : null
      )

      if (match) {
        applied++
        console.log(
          `✓ SOURCE VISUAL: ${topic.slug} → ${section.title}`
        )
      } else {
        cleared++
      }
    }
  }

  console.log("")
  console.log("============================================================")
  console.log(" COMPLETE")
  console.log("============================================================")
  console.log(`✓ Sections cleared of generic visuals: ${cleared}`)
  console.log(`✓ Source visuals applied: ${applied}`)
  console.log("")
  console.log("IMPORTANT:")
  console.log("Only explicitly registered source visuals are now allowed.")
  console.log("All other sections intentionally have no illustration.")
  console.log("")
}

main().catch((error) => {
  console.error("")
  console.error("SOURCE VISUAL UPDATE FAILED")
  console.error(error)
  process.exit(1)
})
